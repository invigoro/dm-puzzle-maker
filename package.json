{
  "name": "daedalus",
  "private": true,
  "version": "0.0.0",
  "description": "Puzzles for tabletop games: make one, send the players a link, and they solve it in their browser without the link ever holding the answer.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "predev": "node scripts/build-icons.ts",
    "dev": "vite",
    "prebuild": "node scripts/build-icons.ts",
    "build": "tsc && tsc -p scripts && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "icon-authors": "node scripts/icon-authors.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@iconify-json/fa7-solid": "^1.2.5",
    "@iconify-json/game-icons": "^1.2.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^28.1.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
